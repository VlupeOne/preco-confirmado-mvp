    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "api:download": "node scripts/api-download.mjs",
    "api:generate": "openapi-typescript openapi/preco-confirmado.openapi.json -o src/lib/api/generated/schema.d.ts",
    "api:check": "node scripts/api-check.mjs",
    "check": "npm run api:check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
